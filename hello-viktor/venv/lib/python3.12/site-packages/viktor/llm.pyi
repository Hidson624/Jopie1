__all__ = ['ViktorOpenAI']

class ViktorOpenAI:
    """ ::version(v14.29.0)

    Helper class for using the VIKTOR OpenAI service.

    Example:

    .. code-block:: python

        from openai import OpenAI
        import viktor as vkt

        client = OpenAI(
            base_url=vkt.ViktorOpenAI.get_base_url(version='v1'),
            api_key=vkt.ViktorOpenAI.get_api_key()
        )
    """
    @staticmethod
    def get_base_url(*, version: str) -> str:
        ''' Returns the base URL to the VIKTOR OpenAI service.

        :param version: version identifier that is appended to the base URL (e.g. "v1")
        '''
    @staticmethod
    def get_api_key() -> str:
        """ Returns the API key that is required to access the VIKTOR OpenAI service. """
